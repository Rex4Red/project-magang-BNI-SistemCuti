# Default local: embedded PostgreSQL in .data, seeded synthetic users, captured emails.
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DEMO_MODE=true
MAIL_MODE=capture
# Set DATABASE_URL for external PostgreSQL; required in production.
# DATABASE_URL=postgresql://user:password@localhost:5432/bni_cuti
